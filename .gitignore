# Python
__pycache__/
*.py[cod]
.venv/
*.db
.env

# Node
node_modules/
.next/
out/
.env*.local

# Editors / OS
.DS_Store
.idea/

# Editor config is committed (interpreter path, search excludes) so the project
# opens correctly for anyone reviewing it; personal VS Code state is not.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Next/TypeScript build metadata
*.tsbuildinfo

# Playwright output: traces and screenshots from a failed run, plus the
# browser binaries it caches. Reports are regenerated, never reviewed from git.
test-results/
playwright-report/
blob-report/
.playwright/
