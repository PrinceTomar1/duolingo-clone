{
  // Show everything. VS Code hides a few paths by default; this project is a
  // submission meant to be read, so nothing in it should be invisible.
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true
  },
  // Build output and dependencies stay visible in the tree, but are skipped by
  // search so results are all first-party code.
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/.next": true,
    "**/package-lock.json": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.next/**": true
  },
  // Gitignored files (the SQLite database, .env.local) stay listed rather than
  // being hidden from the explorer.
  "explorer.excludeGitIgnoredFiles": false,
  "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": ["backend/tests"],
  "[python]": { "editor.rulers": [100] },
  "[typescript]": { "editor.rulers": [100] },
  "[typescriptreact]": { "editor.rulers": [100] }
}
