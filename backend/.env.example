# Turns the /api/v1/dev/* routes on. Set to false in a deployed environment --
# the router is then never registered, so the routes do not exist at all.
DEBUG=true

# Optional: overrides whether the demo clock (/api/v1/dev/*) is mounted,
# independent of DEBUG. Uncomment to set explicitly; unset follows DEBUG.
# ENABLE_DEMO_CLOCK=true

# SQLite by default. Point at Postgres to move off it: the models and Alembic
# migrations are dialect-agnostic apart from the SQLite FK pragma.
DATABASE_URL=sqlite:///./duolingo.db

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
